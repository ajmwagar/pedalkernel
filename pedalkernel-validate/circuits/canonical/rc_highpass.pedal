# Canonical RC highpass filter — highpass discretization test (dual of lowpass)
# C = 22nF, R = 33k
# fc = 1 / (2 * pi * R * C) ≈ 219 Hz
# Oracle: analytical (bilinear transform gives exact discrete-time reference)

pedal "RC Highpass" {
  components {
    C1: cap(22n)
    R1: resistor(33k)
  }
  nets {
    in -> C1.a
    C1.b -> R1.a, out
    R1.b -> gnd
  }
}
