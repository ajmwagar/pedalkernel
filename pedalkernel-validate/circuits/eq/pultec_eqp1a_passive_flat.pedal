# PK:
# Pultec EQP-1A — Passive EQ, FLAT config (all controls off)
# Type: equalizer
#
# Config: LF_Boost=0, LF_Atten=0, HF_Boost=0, HF_BW=0.5, HF_Atten=0
# All audio-taper pots at 0.0 → rp = 10Ω (floor = max_R * 0.001)
# HF_BW linear at 0.5 → rp = 5000Ω
#
# Switched-cap frozen at position 0: CPS=100n, KCS=5600p, HFA_sel=3300p
# Mirrors spice-circuits/eq/pultec_eqp1a_passive_flat.spice

pedal "Pultec EQP-1A (Passive, Flat)" subtitle "Passive EQ section — flat reference" {
  supply 0V
  components {
    R_in: resistor(600)
    CPS:      cap(100n)
    L_lf:     inductor(2H)
    LF_Boost: pot(10k, a)
    LF_Atten: pot(10k, a)
    R_lf:     resistor(56k)
    KCS:      cap(5600p)
    L_hf:     inductor(47m)
    HF_Boost: pot(10k, a)
    HF_BW:    pot(10k)
    HFA_sel:  cap(3300p)
    HF_Atten: pot(10k, a)
    R_hfa:    resistor(100k)
    R_load:   resistor(100k)
  }
  nets {
    in -> R_in.a
    R_in.b -> n_lf
    n_lf -> L_lf.a, CPS.a, R_lf.a
    L_lf.b -> LF_Boost.a
    LF_Boost.b -> gnd
    CPS.b -> LF_Atten.a
    LF_Atten.b -> gnd
    R_lf.b -> n_hf
    n_hf -> L_hf.a, KCS.a
    L_hf.b -> HF_Boost.a
    KCS.b -> HF_Boost.a
    HF_Boost.b -> gnd
    n_hf -> HF_BW.a
    HF_BW.b -> gnd
    n_hf -> n_hfa
    n_hfa -> HFA_sel.a, R_hfa.a
    HFA_sel.b -> HF_Atten.a
    HF_Atten.b -> gnd
    R_hfa.b -> n_out
    n_out -> R_load.a
    R_load.b -> gnd
    n_out -> out
  }
  controls {
    LF_Boost.position -> "LF Boost"     [0.0, 1.0] = 0.0
    LF_Atten.position -> "LF Atten"     [0.0, 1.0] = 0.0
    HF_Boost.position -> "HF Boost"     [0.0, 1.0] = 0.0
    HF_BW.position    -> "HF Bandwidth" [0.0, 1.0] = 0.5
    HF_Atten.position -> "HF Atten"     [0.0, 1.0] = 0.0
  }
}
