# Rauch/MFB high-pass filter with a controlled shunt leg.
# Default Cutoff maps to a 52.5k shunt resistance:
#   range [1.0, 0.05] at default 0.5 => position 0.525.
#
# Candidate repro tracked by pedalkernel-53bz. It is intentionally not
# registered in the passing extraction suite until magnitude equivalence is
# fixed against the paired ngspice fixture.

pedal "Extraction MFB HPF Controlled" {
  components {
    U1: opamp(tl072)
    C1: cap(10n)
    C2: cap(10n)
    Cutoff: pot(100k, b)
    R_fb: resistor(47k)
    R_out: resistor(1k)
  }
  nets {
    in -> C1.a
    C1.b -> C2.a
    C2.b -> U1.neg
    C1.b -> Cutoff.a
    Cutoff.b -> gnd
    U1.neg -> R_fb.a
    R_fb.b -> U1.out
    U1.pos -> gnd
    U1.out -> R_out.a
    R_out.b -> out
  }
  controls {
    Cutoff.position -> "Cutoff" [1.0, 0.05] = 0.5
  }
}
