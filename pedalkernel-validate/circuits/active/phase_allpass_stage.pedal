# Single All-Pass Stage (Phase 90 style)
# JFET variable resistance + op-amp in gain-of-2 configuration
#
# This is ONE stage of a typical phaser circuit.
# The JFET acts as a voltage-controlled resistor in the
# signal path to the op-amp non-inverting input, creating
# a frequency-dependent phase shift via RC lowpass.
#
# All-pass topology:
# - Vin splits to R_ap (opamp-) and JFET Rds (opamp+)
# - R_fb = R_ap: inverting gain = -1 (gain of 2 for V+ path)
# - JFET + C_ap: lowpass on non-inverting input
# - H(s) = (1 - s*Rds*C) / (1 + s*Rds*C)
#
# At 1kHz with 47nF cap: needs ~3.4k JFET resistance

pedal "Phase All-Pass Stage" {
  supply 9V
  components {
    # Input coupling
    C_in: cap(100n)
    R_in: resistor(1M)

    # Virtual ground (Vref = Vcc/2)
    R_vref1: resistor(470k)
    R_vref2: resistor(470k)
    C_vref: cap(10u)

    # All-pass network
    R_ap: resistor(24k)       # Input to opamp(-) (inverting path)
    R_fb: resistor(24k)       # Feedback from opamp out to opamp(-)
    C_ap: cap(47n)            # Phase shift cap (lowpass on non-inv path)
    J1: njfet(2n5952)         # Variable resistance element

    # JFET bias (sets operating point)
    R_jb1: resistor(150k)     # Gate to Vref
    R_jb2: resistor(150k)     # Gate to ground

    # Op-amp (gain-of-2 for non-inverting path)
    U1: opamp(tl072)
    R_load: resistor(10k)     # Output load

    # Output coupling
    C_out: cap(100n)
  }
  nets {
    # Virtual ground
    vcc -> R_vref1.a
    R_vref1.b -> R_vref2.a, C_vref.a
    R_vref2.b -> gnd
    C_vref.b -> gnd

    # Input (AC coupled, biased to Vref)
    in -> C_in.a
    C_in.b -> R_in.a, R_ap.a, J1.drain
    R_in.b -> R_vref1.b

    # Inverting path: R_ap and R_fb to opamp(-)
    R_ap.b -> U1.neg, R_fb.a
    R_fb.b -> U1.out

    # Non-inverting path: JFET Rds + C lowpass to opamp(+)
    J1.source -> C_ap.a, U1.pos
    C_ap.b -> R_vref1.b

    # JFET gate bias
    R_jb1.a -> R_vref1.b
    R_jb1.b -> J1.gate
    R_jb2.a -> J1.gate
    R_jb2.b -> gnd

    # Output
    U1.out -> C_out.a
    C_out.b -> R_load.a, out
    R_load.b -> gnd
  }
}
