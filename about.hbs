<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Third-party licenses &mdash; pedalkernel</title>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #0f1012;
      --fg: #e8e6e3;
      --muted: #9aa0a6;
      --accent: #ffb000;
      --card: #17181c;
      --border: #2a2b30;
      --code-bg: #0a0a0c;
      --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    @media (prefers-color-scheme: light) {
      :root {
        --bg: #fafafa;
        --fg: #1a1a1a;
        --muted: #5a5f66;
        --accent: #b96800;
        --card: #ffffff;
        --border: #e4e4e7;
        --code-bg: #f4f4f5;
      }
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--fg);
      font-family: var(--sans);
      line-height: 1.6;
    }
    main { max-width: 820px; margin: 0 auto; padding: 3rem 1.5rem 4rem; }
    header {
      margin-bottom: 2rem;
      padding-bottom: 1.2rem;
      border-bottom: 1px solid var(--border);
    }
    h1 {
      font-family: var(--mono);
      font-size: 1.8rem;
      margin: 0 0 0.4rem;
      letter-spacing: -0.01em;
    }
    .subtitle { color: var(--muted); margin: 0; font-size: 1rem; }
    details {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 8px;
      margin: 0.6rem 0;
      padding: 0.9rem 1.1rem;
    }
    details[open] { border-color: var(--accent); }
    summary {
      cursor: pointer;
      font-family: var(--mono);
      font-size: 0.95rem;
      color: var(--accent);
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }
    summary .meta {
      color: var(--muted);
      font-size: 0.85rem;
      font-weight: normal;
    }
    .used-by {
      font-size: 0.85rem;
      color: var(--muted);
      margin: 0.8rem 0 0;
    }
    pre {
      background: var(--code-bg);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.9rem 1.1rem;
      margin: 0.9rem 0 0;
      overflow-x: auto;
      font-family: var(--mono);
      font-size: 0.82rem;
      line-height: 1.5;
      white-space: pre-wrap;
      word-break: break-word;
    }
    .license-group { margin: 2rem 0 1rem; }
    .license-group h2 {
      font-family: var(--mono);
      font-size: 0.82rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
      margin: 0 0 0.8rem;
    }
    .note {
      margin: 1.2rem 0 2rem;
      padding: 0.9rem 1.1rem;
      border-left: 3px solid var(--accent);
      background: var(--card);
      border-radius: 4px;
      font-size: 0.92rem;
      color: var(--muted);
    }
    footer {
      border-top: 1px solid var(--border);
      margin-top: 3rem;
      padding-top: 1rem;
      font-size: 0.8rem;
      color: var(--muted);
    }
  </style>
</head>
<body>
<main>
  <header>
    <h1>Third-party licenses</h1>
    <p class="subtitle">Open-source components bundled with pedalkernel.</p>
  </header>

  <div class="note">
    pedalkernel itself is licensed under AGPL-3.0-or-later. The components
    listed below are the third-party Rust crates statically linked into
    the binary. Each crate is distributed under its own license, reproduced
    verbatim in the collapsible section.
  </div>

  {{#each overview}}
  <div class="license-group">
    <h2>{{name}} &mdash; {{count}} crate{{#if (gt count 1)}}s{{/if}}</h2>
  </div>
  {{/each}}

  {{#each licenses}}
  <details>
    <summary>
      <span>{{name}} {{version}}</span>
      <span class="meta">{{id}}</span>
    </summary>
    {{#if used_by}}
    <p class="used-by">Used by:
      {{#each used_by}}<code>{{crate.name}} {{crate.version}}</code>{{#unless @last}}, {{/unless}}{{/each}}
    </p>
    {{/if}}
    <pre>{{text}}</pre>
  </details>
  {{/each}}

  <footer>
    Generated by <code>cargo about</code> from <code>Cargo.lock</code>.
  </footer>
</main>
</body>
</html>
