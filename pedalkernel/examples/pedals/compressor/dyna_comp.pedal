# MXR Dyna Comp compressor
# OTA-based (CA3080) compression with envelope follower
# Single-knob simplicity: Output level + Sensitivity control
# Essential for country, funk, and chicken pickin'
#
# Signal path: in -> C1 -> R1 -> OTA -> C3 -> Output pot -> out
# Sidechain: envelope follower tracks input amplitude -> modulates OTA Iabc
# When input is loud, envelope rises, reducing OTA gain (compression).

pedal "MXR Dyna Comp" {
  components {
    C1: cap(1u)             # Input coupling
    R1: resistor(10k)       # Input impedance
    U1: opamp(ca3080)       # CA3080 OTA - current-controlled gain for compression
    R2: resistor(150k)      # Feedback resistor (sets compression ratio)
    C2: cap(1u)             # Envelope smoothing
    R3: resistor(560k)      # Bias network
    C3: cap(100n)           # Output coupling
    EF1: envelope_follower(1k, 10u, 100k, 1u, 10k)  # Attack ~10ms, release ~100ms
    Sensitivity: pot(50k, a)  # Compression amount (audio taper)
    Output: pot(500k, a)    # Output level (audio taper)
  }
  nets {
    in -> C1.a
    C1.b -> R1.a
    R1.b -> U1.pos, R3.a
    R3.b -> vcc
    U1.neg -> R2.a, C2.a
    R2.b -> U1.out
    C2.b -> Sensitivity.a
    Sensitivity.b -> gnd
    U1.out -> C3.a
    C3.b -> Output.a
    Output.w -> out
    Output.b -> gnd
    EF1.in -> C1.b
    EF1.out -> U1.iabc
  }
  controls {
    Sensitivity.position -> "Sensitivity" [0.0, 1.0] = 0.5
    Output.position -> "Output" [0.0, 1.0] = 0.7
  }
}
