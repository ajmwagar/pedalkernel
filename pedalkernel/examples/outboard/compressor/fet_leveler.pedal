# PK:
# FET Leveler — Urei 1176-inspired FET feedback limiter. Grab-anything peak
# limiting with the famous "all-buttons" aggression dialed back to a single,
# musical ratio. Input drives the gain reduction; Output restores level.
# Type: compressor (outboard studio gear)
#
# PROVENANCE — Urei 1176LN, rev D ("blackface", 1970, Bill Putnam Sr.)
#   Topology: the audio path enters an input attenuator, then hits a gain
#   reduction stage where an N-channel FET (2N5457 in early units) acts as a
#   VOLTAGE-VARIABLE SHUNT RESISTOR forming a divider with a series resistor.
#   The FET's Rds is driven by the sidechain DC. After the divider, a class-A
#   line amplifier provides ~45 dB of makeup gain into the output transformer.
#   Detector: FEEDBACK type — the sidechain rectifier taps the OUTPUT of the
#   unit, not the input.
#
# KEY TIME CONSTANTS (real unit):
#   Attack:  20 µs – 800 µs (front-panel pot, sidechain series R into ~220 nF)
#   Release: 50 ms – 1.1 s  (release pot up to ~5 MΩ against the same ~220 nF)
#   Ratio:   4:1 / 8:1 / 12:1 / 20:1 via push-button divider that offsets the
#            FET gate bias and detector drive (plus the "all buttons" mode).
#
# AS MODELED HERE:
#   in -> C_in -> Input pot (attenuator) -> R_gr series / J1 (2N5457) shunt
#      -> C_c1 -> Q1 (2N3904 class-A common-emitter line amp, makeup gain)
#      -> C_out -> T_out (1:1 output transformer) -> Output pot -> out
#   Sidechain: EF1 envelope follower drives J1.vgs.
#     envelope_follower(attack_r, attack_c, release_r, release_c, sens_r)
#     EF1 = (25k, 220n, 5M, 220n, 20k)
#       attack  tau = 25 kΩ × 220 nF = 5.5 ms (slowest practical order for the
#                real 25kΩ-order attack network; real unit reaches 20 µs)
#       release tau = 5 MΩ × 220 nF = 1.1 s (real unit's slowest release)
#
# SIMPLIFICATIONS vs real unit (audit notes — deviations are intentional):
#   1. NO input transformer (real: UTC O-12 600 Ω bridged-T input). The input
#      attenuator is a plain 10k pot instead of the bridged-T pad.
#   2. Output transformer INCLUDED as a 1:1, 10 H winding with 75 ohm DCR and
#      200 pF parasitics. It compiles cleanly; measured cost in the current
#      engine is ~3.6 dB (peak 0.0183 with vs 0.0277 without, 0.2 amplitude
#      220 Hz probe). The real unit's output iron is a step-down driving
#      600 ohms.
#   3. NO ratio switch — single fixed ratio set by the envelope follower's
#      sensitivity; the real 4/8/12/20:1 bias-offset network is future work.
#   4. The line amp is a single BJT common-emitter stage, not the real
#      five-transistor class-A line amplifier.
#   5. FEEDBACK detector: EF1.in is wired to the output node (rev D feedback
#      topology) and the engine now HONORS the tap — the detector reads the
#      circuit output one sample late (compile-time tap resolution, G1 fix).
#      Feed-forward taps (e.g. `EF1.in -> C_in.b`) are honored too.
#   6. Program-dependent attack (20–800 µs) is collapsed to one fixed RC pair.
#   7. ENGINE LIMITATION (updated 2026-06-12, F5): the EF1 -> J1.vgs
#      modulation path is LIVE (rewiring the detector to `C_in.b` measures
#      >15 dB of gain reduction on this very circuit), but with the feedback
#      tap the detector is starved: the simulated chain sits at ~-58 dB
#      overall (the BJT line amp contributes almost no makeup gain — audit
#      gap G5 family — and the output transformer costs ~19 dB more than
#      SPICE), so the output node delivers only ~mV-level drive and GR
#      measures ~0 dB. Expect real feedback compression here once the
#      makeup-gain/transformer defects are fixed, not before.

equipment "FET Leveler 1176" {
  supply 30V               # Real 1176 runs a single +30 V rail

  components {
    # === Input attenuator ===
    C_in: cap(100n)        # Input coupling
    Input: pot(10k, a)     # Input level (real unit: 600 ohm bridged-T pad)

    # === Gain reduction divider: series R + FET shunt ===
    R_gr: resistor(2.7k)   # Series arm of the GR divider (few-kOhm order)
    J1: njfet(2n5457)      # Shunt FET — Rds(on) varies with gate drive
    R_gbias: resistor(1M)  # Gate bleed/bias return (keeps gate referenced)

    # === Makeup gain — class-A line amp (BJT common-emitter) ===
    C_c1: cap(100n)        # Coupling into line amp
    R_b: resistor(470k)    # Base bias from supply
    Q1: npn(2n3904)        # Line amp transistor (real: 5-transistor class A)
    R_c: resistor(10k)     # Collector load
    R_e: resistor(2.2k)    # Emitter degeneration
    C_e: cap(47u, electrolytic)  # Emitter bypass — full AC gain

    # === Output ===
    C_out: cap(100n)       # Output coupling
    T_out: transformer(1:1, 10H, 75, 200p)  # Line output iron (see note 2)
    Output: pot(100k, a)   # Output level

    # === Sidechain ===
    # envelope_follower(attack_r, attack_c, release_r, release_c, sens_r)
    # Attack 25k x 220n = 5.5 ms; Release 5M x 220n = 1.1 s (slowest 1176 release)
    EF1: envelope_follower(25k, 220n, 5M, 220n, 20k)
  }

  nets {
    # --- Input attenuator ---
    in -> C_in.a
    C_in.b -> Input.a
    Input.b -> gnd
    Input.w -> R_gr.a

    # --- GR divider: R_gr series, J1 drain-source shunt to ground ---
    R_gr.b -> J1.drain, C_c1.a
    J1.source -> gnd
    J1.gate -> R_gbias.a
    R_gbias.b -> gnd

    # --- Line amp (makeup gain) ---
    C_c1.b -> R_b.a, Q1.base
    R_b.b -> vcc
    vcc -> R_c.a
    R_c.b -> Q1.collector
    Q1.emitter -> R_e.a, C_e.a
    R_e.b -> gnd
    C_e.b -> gnd

    # --- Output transformer and level ---
    Q1.collector -> C_out.a
    C_out.b -> T_out.pri.a
    T_out.pri.b -> gnd
    T_out.sec.a -> Output.a
    T_out.sec.b -> gnd
    Output.w -> out
    Output.b -> gnd

    # --- Sidechain: FEEDBACK detector (tapped from output) drives FET gate ---
    # NOTE: engine currently reads EF input from the global pedal input; this
    # net documents the real rev D feedback topology (see header, item 5).
    EF1.in -> Output.w
    EF1.out -> J1.vgs
  }

  controls {
    Input.position -> "Input" [0.0, 1.0] = 0.7
    Output.position -> "Output" [0.0, 1.0] = 0.7
  }
}
