# parent_vcc_override.pedal — instantiates sub_vcc and explicitly maps the
# instance rail `s.vcc` to a parent node `vrail`, overriding the implicit
# global vcc unification.
pedal "ParentVccOverride" {
  supply 9V
  components {
    Rrail: resistor(1k)
    s: use("sub/sub_vcc.pedal")
  }
  nets {
    in -> s.in
    s.out -> out
    vcc -> Rrail.a
    Rrail.b -> vrail
    s.vcc -> vrail
  }
  controls {}
}
