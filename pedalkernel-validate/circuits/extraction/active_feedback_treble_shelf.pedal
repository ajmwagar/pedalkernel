# Goldenrod-style inverting active-feedback treble shelf.
# Treble defaults to 0.5, so the SPICE reference uses 5k/5k split pot legs.

pedal "Extraction Active Feedback Treble Shelf" {
  components {
    U1: opamp(tl072)
    R_in: resistor(10k)
    R_fb: resistor(10k)
    C_tone: cap(3.9n)
    Treble: pot(10k, b)
    R_shelf: resistor(4.7k)
    R_out: resistor(1k)
  }
  nets {
    in -> R_in.a
    R_in.b -> U1.neg
    U1.neg -> R_fb.a
    R_fb.b -> U1.out
    U1.neg -> C_tone.a
    C_tone.b -> Treble.a
    Treble.w -> R_shelf.a
    R_shelf.b -> U1.out
    Treble.b -> U1.out
    U1.pos -> gnd
    U1.out -> R_out.a
    R_out.b -> out
  }
  controls {
    Treble.position -> "Treble" [0.0, 1.0] = 0.5
  }
}
