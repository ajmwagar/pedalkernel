# XREF DC-coupled, CAP-FREE 2-BJT cascade — for the 1:1 SPICE-vs-WDF balance-
# residual diagnostic. Two DC-coupled 2N3904 CE stages, UN-BYPASSED emitters,
# NO reactive elements at all. With no caps, the MultiNl stage has zero passive
# ports, so known_a[i] = dc_bias[i] exactly (no Σ s_nl_passive·b_passive term).
# This isolates the multi-BJT scattering + dc_bias math so the residual check
# `R[i] = known_a[i] + Σ_j s_nl[i][j]·b[j] − a[i]` is uncontaminated by cap state.
# Faithful twin of spice-circuits/active/xref_twostage_dc.spice.

pedal "XREF Two-Stage DC (cap-free)" {
  supply 24V

  ports {
    in: input
    out: output
  }

  components {
    Rin:  resistor(2k2)
    RB1a: resistor(220k)           # Q1 base divider (to vcc)
    RB1b: resistor(33k)            # Q1 base divider (to gnd)

    Q1:   npn(2n3904)
    RC1:  resistor(10k)
    RE1:  resistor(1k)

    Q2:   npn(2n3904)
    RC2:  resistor(4k7)
    RE2:  resistor(1k)

    RL:   resistor(10k)
  }

  nets {
    in -> Rin.a
    Rin.b -> Q1.base, RB1a.b, RB1b.a       # nb1
    RB1a.a -> vcc
    RB1b.b -> gnd

    vcc -> RC1.a
    RC1.b -> Q1.collector, Q2.base          # nc1 (DC-coupled inter-stage)
    Q1.emitter -> RE1.a
    RE1.b -> gnd

    vcc -> RC2.a
    RC2.b -> Q2.collector, RL.a, out        # nout
    Q2.emitter -> RE2.a
    RE2.b -> gnd

    RL.b -> gnd
  }
}
