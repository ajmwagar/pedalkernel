# Compact op-amp and OTA model registry for PedalKernel.
#
# These are scalar behavioral parameters used by the realtime WDF/MNA roots,
# not full vendor .SUBCKT macro-models. Units:
#   A0/AOL = V/V, GBW = Hz, SR = V/us, rails = V, RO/RLOAD = Ohm,
#   COUT = F, GM = S, IABC = A, VT = V.

.OPAMP GENERIC A0=100k GBW=1MEG SR=1 VPOS=12 VNEG=12 RO=75 COUT=20p
.OPAMP TL072 A0=200k GBW=3MEG SR=13 VPOS=12 VNEG=12 RO=75 COUT=20p
.OPAMP TL082 A0=200k GBW=4MEG SR=13 VPOS=12 VNEG=12 RO=75 COUT=20p
.OPAMP JRC4558 A0=100k GBW=3MEG SR=1.7 VPOS=12 VNEG=12 RO=75 COUT=20p
.OPAMP RC4558 A0=100k GBW=3MEG SR=1.5 VPOS=12 VNEG=12 RO=75 COUT=20p
.OPAMP LM308 A0=300k GBW=1MEG SR=0.3 VPOS=12 VNEG=12 RO=200 COUT=30p
.OPAMP LM741 A0=200k GBW=1MEG SR=0.5 VPOS=12 VNEG=12 RO=75 COUT=20p
.OPAMP NE5532 A0=100k GBW=10MEG SR=9 VPOS=12 VNEG=12 RO=50 COUT=15p
.OPAMP OP07 A0=400k GBW=600k SR=0.3 VPOS=12 VNEG=12 RO=60 COUT=25p

.OTA CA3080 A0=100k GBW=2MEG SR=50 VPOS=12 VNEG=12 RO=75 COUT=20p IABC=100u VT=25.8649m GM=2m RLOAD=10k
